# Copy to .env.local for development. Never commit real values.
# Database: Postgres in production (Neon). Leave empty locally to use a SQLite file.
DATABASE_URL=
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://nanditaspeaks.in
# Media uploads on Vercel (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
# Email (Resend, verified nanditaspeaks.in domain)
RESEND_API_KEY=
EMAIL_FROM="Nandita Speaks <enquiries@nanditaspeaks.in>"
ENQUIRY_NOTIFY_TO=
# Spam protection (Cloudflare Turnstile, invisible)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Analytics 4
NEXT_PUBLIC_GA_ID=
# Vercel Cron authorisation for the email retry job
CRON_SECRET=
# Optional: force design notes on (1) or off (0); default is on everywhere except production
SITE_PREVIEW_NOTES=
